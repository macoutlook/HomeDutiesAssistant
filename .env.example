# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# docker-compose reads it automatically.

# PostgreSQL password — used by the db container AND the app's connection string.
# NOTE: Postgres only applies this on first initialization of the data volume.
# For an existing volume, keep the original password or recreate the volume.
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key — at least 32 bytes (256 bits). Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=change-me-generate-a-32-byte-random-key

# Hostname Caddy serves and provisions TLS for.
#   - a real domain (e.g. duties.example.com) -> automatic Let's Encrypt HTTPS
#   - "localhost" -> Caddy's internal self-signed CA (fine for LAN/testing)
SITE_ADDRESS=localhost

# Host ports for the Caddy TLS proxy. Defaults are the standard 80/443; override
# only if another proxy already uses them (then browse https://localhost:HTTPS_PORT).
HTTP_PORT=80
HTTPS_PORT=443

# Seq (structured logging) — admin password for the Seq UI (required on first
# run) and the host port to expose its web UI on.
SEQ_ADMIN_PASSWORD=change-me-seq-admin-password
SEQ_UI_PORT=8082

# SMTP password for email-confirmation mode (a secret — kept here, never in
# appsettings.json). OPTIONAL: leave it unset (or blank) to use admin-approval
# mode instead. The non-secret SMTP settings (Host, User, From, Port) go in
# HomeDutiesAssistant.Web/appsettings.json under the "Smtp" section.
SMTP_PASSWORD=change-me-smtp-password

# Host directory holding the Phi-4 (ONNX) model — bind-mounted read-only into the
# web container at /models/phi4 for PDF bill extraction. It must contain
# genai_config.json, model.onnx, model.onnx.data, tokenizer.json, etc.
# Defaults to the repo-local models/ path (git-ignored; download it yourself).
# Leave the model absent + remove the mount to fall back to raw-text-into-Notes.
ONNX_MODEL_DIR=./models/phi4/cpu_and_mobile/cpu-int4-rtn-block-32-acc-level-4