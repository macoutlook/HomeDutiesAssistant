@inherits LayoutComponentBase
@using System.Security.Claims

<div class="phone-stage">
    <div class="account">
        <LanguageSwitcher />
        <AuthorizeView>
            <Authorized>
                <span class="account-user">@context.User.Identity?.Name · @RoleOf(context.User)</span>
                <form class="logout" method="post" action="/auth/logout">
                    <button type="submit" class="account-signout">@Localizer["Sign out"]</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>

    <img class="app-logo" src="home_duties_assistant_wordmark.svg" alt="Home Duties Assistant" />
    <div class="phone">
        <nav class="navbar">
            <AuthorizeView Policy="@AuthorizationPolicies.CanRead">
                <NavLink class="navlink" href="" Match="NavLinkMatch.All">@Localizer["Chat"]</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthorizationPolicies.CanManage">
                <NavLink class="navlink" href="tasks" Match="NavLinkMatch.All">@Localizer["Tasks"]</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthorizationPolicies.CanManage">
                <NavLink class="navlink" href="duties" Match="NavLinkMatch.All">@Localizer["Duties"]</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthorizationPolicies.CanAdminHome">
                <NavLink class="navlink" href="manage/users">@Localizer["Users"]</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@AuthorizationPolicies.CanAdmin">
                <NavLink class="navlink" href="manage/homes">@Localizer["Homes"]</NavLink>
            </AuthorizeView>
        </nav>
        <main>
            @Body
        </main>
    </div>
</div>

@code {
    private string RoleOf(ClaimsPrincipal user)
        => Localizer[user.FindFirst(JwtTokenService.RoleClaim)?.Value ?? ""];
}